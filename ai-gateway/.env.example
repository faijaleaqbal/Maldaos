# CampusPulse AI Gateway — environment configuration
# Copy to ".env" and fill in real values for local development.
# NEVER commit real keys, tokens, or service-role credentials.

# ----- Provider API keys (backend only; never exposed to frontend) -----
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=

# ----- Provider endpoints (override only for self-hosted / proxied setups) -----
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Google AI Studio's OpenAI-compatible surface (NOT the plain /v1beta path)
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ----- Model selection (configurable per provider) -----
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GOOGLE_AI_STUDIO_MODEL=gemini-3.5-flash-lite

# ----- Gateway behavior -----
AI_GATEWAY_TIMEOUT_MS=15000
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_RETRY_BASE_MS=300

# Comma-separated ordered provider chain. First healthy provider is primary.
# Remaining entries are fallbacks. Last entry is the deterministic fallback.
AI_GATEWAY_PROVIDER_CHAIN=groq,openrouter,nvidia,google,deterministic

# ----- Logging -----
AI_GATEWAY_LOG_LEVEL=info