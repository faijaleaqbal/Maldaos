# ====================================================================
# CampusPulse — Malda College Environment Configuration
# ====================================================================

# Frontend Toggle: MOCK MODE vs REAL SUPABASE MODE
# Set to 'true' to use the isolated in-memory mock data layer for development & demos
# Set to 'false' to connect to live PostgreSQL via Supabase RLS
NEXT_PUBLIC_USE_MOCK_DATA=true

# Supabase Public Configuration (Safe for browser exposure)
# Do NOT place service_role or admin secret keys here!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Server-side AI Gateway Keys (NEVER prefix with NEXT_PUBLIC_)
# Only accessible in Next.js Route Handlers (e.g. /api/ai/analyze).
# Leave ALL of these empty to force the deterministic fallback path.
# The gateway chain order is set by AI_GATEWAY_PROVIDER_CHAIN.
AI_GATEWAY_PROVIDER_CHAIN=groq,openrouter,nvidia,google,deterministic
AI_GATEWAY_TIMEOUT_MS=15000
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_RETRY_BASE_MS=300
AI_GATEWAY_LOG_LEVEL=info

# Per-provider keys (server-only). At least one is required for REAL_PROVIDER
# responses; otherwise every request is recorded as RULE_BASED_FALLBACK.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=

# Optional overrides (use defaults unless self-hosting).
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GOOGLE_AI_STUDIO_MODEL=gemini-1.5-flash

# Supabase SERVICE_ROLE key — SERVER ONLY (used by /api/ai/* to persist
# AI results to public.ai_analysis). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
