# CampusPulse backend — copy to .env and fill values from `supabase status`
# NEVER commit real secrets. Local dev keys are generated by your local Supabase stack.

# Local Supabase API (default: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Public anon key (safe for browser; RLS still applies)
SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, never ship to the client/browser
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (for psql-based tooling/tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Seed users' passwords (local test credentials only)
SEED_PASSWORD=TestPass123!
