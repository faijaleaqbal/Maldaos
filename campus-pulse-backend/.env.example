# CampusPulse backend — copy to .env and fill values from `supabase status`
# NEVER commit real secrets. Local dev keys are generated by your local Supabase stack.

# Local Supabase API (default: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Public anon key (safe for browser; RLS still applies)
SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, never ship to the client/browser
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (for psql-based tooling/tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Seed users' passwords (local test credentials only)
SEED_PASSWORD=TestPass123!

# ----- AI Gateway (server-only; never exposed to the frontend) -----
# Leave blank to force the deterministic fallback path in tests.
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GOOGLE_AI_STUDIO_MODEL=gemini-1.5-flash

# Comma-separated ordered chain. Last entry should be 'deterministic'.
AI_GATEWAY_PROVIDER_CHAIN=groq,openrouter,nvidia,google,deterministic
AI_GATEWAY_TIMEOUT_MS=15000
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_RETRY_BASE_MS=300
AI_GATEWAY_LOG_LEVEL=info

# In tests, set AI_GATEWAY_TEST_MODE=stub to avoid any real HTTP calls.
AI_GATEWAY_TEST_MODE=
