{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDirs": ["src", "../ai-gateway/src"],
    "baseUrl": ".",
    "paths": {
      "@campuspulse/ai-gateway": ["../ai-gateway/src/index.ts"],
      "@campuspulse/ai-gateway/*": ["../ai-gateway/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../ai-gateway/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "supabase", "tests", "scripts", "../ai-gateway/test", "../ai-gateway/node_modules"]
}
