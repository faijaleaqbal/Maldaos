# ====================================================================
# CampusPulse — PRODUCTION environment configuration (TEMPLATE ONLY)
# Copy to .env.production (git-ignored) and fill in real values at
# deploy time. NEVER commit the filled-in file.
#
# Production Supabase project: qymlvgqtihoploywzrer ("Maldaos")
# Hosted URL: https://qymlvgqtihoploywzrer.supabase.co
# ====================================================================

# Frontend toggle — production NEVER uses mock data (fail-closed in code)
NEXT_PUBLIC_USE_MOCK_DATA=false

# --- Supabase public configuration (browser-safe values ONLY) ---
# The anon/publishable key is safe for browser exposure; RLS remains the
# data-plane authority. NEVER put the service-role key or DB password here.
NEXT_PUBLIC_SUPABASE_URL=https://qymlvgqtihoploywzrer.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production publishable/anon key — obtain from Supabase dashboard>

# --- Server-side AI Gateway keys (NEVER prefix with NEXT_PUBLIC_) ---
# Read by the /api/ai/analyze route handler only (server runtime).
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
# Optional additional providers in the fallback chain:
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Model identifiers (defaults are current; override only if decommissioned)
# GROQ_MODEL=openai/gpt-oss-20b
# GOOGLE_AI_STUDIO_MODEL=gemini-3.5-flash-lite

# --- Gateway behavior ---
AI_GATEWAY_PROVIDER_CHAIN=groq,openrouter,nvidia,google,deterministic
AI_GATEWAY_TIMEOUT_MS=15000

# ====================================================================
# DEPLOYMENT NOTES
# 1. Local development keeps using .env (http://127.0.0.1:54321 stack).
# 2. Migrations must be pushed to the production project with
#    `supabase db push` (or Supabase dashboard) BEFORE deploying the app.
#    Status as of 2026-09-05: migrations 0001-0008 applied to
#    qymlvgqtihoploywzrer (verified via `supabase migration list --linked`).
# 3. Seed data (campus-pulse-backend/scripts/seed.ts) is a LOCAL TEST
#    fixture — do not run against production unless intentionally
#    provisioning demo data.
#
# HOSTED DEPLOYMENT (this workspace, maldacollege.duckdns.org):
#   - Build:   cp .env.production .env && npm run build   (then restore .env)
#     (.env.production takes precedence over .env for `next start` in
#     production mode; either way, verify the baked URL with:
#     grep -o "qymlvgqtihoploywzrer" .next/server/src/middleware.js)
#   - Serve:   systemctl start campuspulse   (unit: /etc/systemd/system/
#     campuspulse.service, port 3101, EnvironmentFile=.env.production)
#   - TLS:     nginx site maldacollege.conf + Let's Encrypt cert
#     (/etc/letsencrypt/live/maldacollege.duckdns.org/, auto-renew via certbot)
# ====================================================================
